#!/bin/zsh -f
# Mock /bin/kill. Logs "SIG PID". -TERM removes the process from
# $MOCK_DIR/procs unless $MOCK_DIR/stubborn_PID exists; -KILL always does.
# -0 PID exits 0 while the process is listed.
setopt extended_glob
sig=${1#-} pid=$2
[[ $# == 2 && $pid == <-> ]] || { print -u2 "mock kill: bad args $*"; exit 2 }
F=$MOCK_DIR/procs
alive() { grep -q "^$pid	" $F 2>/dev/null && [[ ! -e $MOCK_DIR/dead_$pid ]] }
alive || exit 1
[[ $sig == 0 ]] && exit 0
print -r -- "$sig $pid" >> $MOCK_DIR/kill.log
# Simulate PID reuse during the wait: a new process takes the PID after TERM.
[[ $sig == TERM && -e $MOCK_DIR/reuse_$pid ]] && print "Thu Nov 19 10:00:00 2026" > $MOCK_DIR/newstart_$pid
if [[ $sig == KILL || ( $sig == TERM && ! -e $MOCK_DIR/stubborn_$pid ) ]]; then
  touch $MOCK_DIR/dead_$pid
fi
exit 0
